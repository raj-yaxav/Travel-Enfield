{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/trips/:path*", "destination": "/app.html" },
    { "source": "/destinations/:path*", "destination": "/app.html" },
    { "source": "/blog/:path*", "destination": "/app.html" },
    { "source": "/upcoming-trips", "destination": "/app.html" },
    { "source": "/domestic-trips", "destination": "/app.html" },
    { "source": "/international-trips", "destination": "/app.html" },
    { "source": "/weekend-trips", "destination": "/app.html" },
    { "source": "/deals", "destination": "/app.html" },
    { "source": "/bike-trips", "destination": "/app.html" },
    { "source": "/backpacking-trips", "destination": "/app.html" },
    { "source": "/trekking-trips", "destination": "/app.html" },
    { "source": "/custom-trip", "destination": "/app.html" },
    { "source": "/about-us", "destination": "/app.html" },
    { "source": "/contact-us", "destination": "/app.html" },
    { "source": "/reviews", "destination": "/app.html" },
    { "source": "/faq", "destination": "/app.html" },
    { "source": "/privacy-policy", "destination": "/app.html" },
    { "source": "/terms-and-conditions", "destination": "/app.html" },
    { "source": "/cancellation-policy", "destination": "/app.html" },
    { "source": "/login", "destination": "/app.html" },
    { "source": "/signup", "destination": "/app.html" }
  ]
}
